    {
      "name": "Pet",
      "description": "CRUD operations for pets — add, update, find, delete",
      "item": [
        {
          "name": "Add a new pet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/pet", "host": ["{{baseUrl}}"], "path": ["pet"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 91001,\n  \"category\": { \"id\": 1, \"name\": \"Dogs\" },\n  \"name\": \"Buddy\",\n  \"photoUrls\": [\"https://example.com/buddy.jpg\"],\n  \"tags\": [{ \"id\": 1, \"name\": \"golden-retriever\" }],\n  \"status\": \"available\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains pet name', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql('Buddy');",
                  "});",
                  "",
                  "pm.test('Pet ID is returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.collectionVariables.set('petId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get pet by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pet/{{petId}}", "host": ["{{baseUrl}}"], "path": ["pet", "{{petId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Pet name matches', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql('Buddy');",
                  "});",
                  "",
                  "pm.test('Status is available', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('available');",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('photoUrls');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
