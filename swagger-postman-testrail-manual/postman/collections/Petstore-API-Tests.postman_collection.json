{
  "info": {
    "name": "Petstore API Tests",
    "description": "Manual API test collection for the Swagger Petstore (https://petstore.swagger.io/v2). Covers all 20 endpoints across Pet, Store, and User modules with assertions, chained variables, and negative tests.\n\nAuthor: Jigyasa Gupta — QA Engineer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://petstore.swagger.io/v2" },
